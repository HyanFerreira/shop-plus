APP_NAME=ShopPlus
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://shopplus.test
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=shopplus_sds_demo_20261026
DB_USERNAME=shopplus_app
DB_PASSWORD=

HASH_DRIVER=argon2id
PII_BLIND_INDEX_KEY=
DEMO_PASSWORD=
SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=7
LOG_LEVEL=warning
# Demo without external SMTP; messages are discarded, not delivered.
MAIL_MAILER=array
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@shopplus.test
MAIL_FROM_NAME=ShopPlus

# Academic generator is opt-in; one additional cycle every five minutes.
ACADEMIC_AUTOMATION_ENABLED=false
ACADEMIC_APPROVED_PERCENT=70
ACADEMIC_DECLINED_PERCENT=20
ACADEMIC_PENDING_PERCENT=10
